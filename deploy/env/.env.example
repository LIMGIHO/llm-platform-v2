# ─────────────────────────────────────────────
# LM Studio  (호스트에서 실행, 컨테이너→host.docker.internal)
# ─────────────────────────────────────────────
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_CHAT_MODEL=gemma-4-e4b
LMSTUDIO_MODEL_ROUTER=qwen3.5-4b
LMSTUDIO_MODEL_VERIFIER=qwen3.5-9b
LMSTUDIO_EMBED_MODEL=bge-m3
LMSTUDIO_CTX=8192
LLM_TIMEOUT_SEC=180

# ─────────────────────────────────────────────
# Postgres
# 컨테이너 → SSH 터널(Mac 15432) → 105:5432
# extra_hosts: postgres → host-gateway(Mac 192.168.5.2)
# ─────────────────────────────────────────────
POSTGRES_USER=llm-platform
POSTGRES_PASSWORD=1234
POSTGRES_DB=llm-platform
PG_DSN=postgresql+psycopg://llm-platform:1234@postgres:15432/llm-platform

# ─────────────────────────────────────────────
# Qdrant
# 컨테이너 → SSH 터널(Mac 16333) → 105:6333
# extra_hosts: qdrant → host-gateway(Mac 192.168.5.2)
# ─────────────────────────────────────────────
QDRANT_URL=http://qdrant:16333
QDRANT_API_KEY=

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_PORT=8000
TRACE_TEXT_LIMIT=1200
ANSWER_SCORE_FLOOR=0.35
RERANK_TOP_K=10
HYBRID_ALPHA=0.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Style pack
STYLE_TOP_K=3
STYLE_AUTHOR=              # 빈 값=전체 댓글 사용. 메르 작성자 이름으로 설정하면 해당 댓글만 사용
STYLE_MIN_LEN=50
STYLE_MAX_LEN=600

# ─────────────────────────────────────────────
# Batch
# ─────────────────────────────────────────────
BATCH_DATA_DIR=/data
BATCH_BLOG_EXPORT=/data/import/mer_blog_posts.json
BATCH_COMMENT_EXPORT=/data/import/mer_blog_comments.json

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
GF_ADMIN_PASSWORD=admin
